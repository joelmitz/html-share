{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "html-share-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // workers.dev と preview URL を無効にし、Access で保護されたカスタムドメイン経由のみで公開する
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [
    // 管理面ドメインに合わせて書き換える
    { "pattern": "html-share-console.example.com", "custom_domain": true }
  ],
  // web/配下の静的資産（HTML/JS/CSS/アイコン）をWorkerへ同梱する（設計§5）。
  // wrangler deployのたびに世代ごと原子的に入れ替わり、旧デプロイの資産は
  // 切替後に不可達になる（プラットフォーム保証）。run_worker_firstにより
  // 全リクエストが先にこのWorkerを通るため、/app/*・/review/*のAccess JWT検証は
  // 引き続きWorker側で行い、通過後にのみASSETSへ委譲する（index.tsのserveStatic）。
  "assets": { "directory": "../../web", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [
    // publish lock/commit・世代GC・purgeがcontentバケットのオブジェクトを
    // list/delete/検証するために必要（CLIのS3 API書き込みとは別に、Worker側の
    // 管理操作専用）
    { "binding": "CONTENT", "bucket_name": "html-share-content" },
    // visibility='internal'なページの世代GC・purge検証用（internal Worker新設）。
    // 実際のオブジェクト配信はinternal Worker（別デプロイ）が行う
    { "binding": "INTERNAL", "bucket_name": "html-share-internal" }
  ],
  "d1_databases": [
    // database_id は `wrangler d1 create html-share-review` の出力で書き換える
    { "binding": "DB", "database_name": "html-share-review", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "vars": {
    // すべて自分の環境に合わせて書き換える
    "OWNER_EMAIL": "owner@example.com",
    "CONSOLE_ORIGIN": "https://html-share-console.example.com",
    "CONTENT_ORIGIN": "https://html-share-content.example.com",
    // visibility='internal'なページのオーナーリンクが指す先（internal Workerのドメイン）
    "INTERNAL_ORIGIN": "https://html-share-internal.example.com",
    "MAXIMUM_SHARE_DAYS": "30",
    // GET /api/owner/pages が本人用リンクをその場で署名する際の有効期間。
    // 表示のたびに再署名されるため、実質は「開いたタブを放置できる期間」
    "OWNER_LINK_DAYS": "30",
    "ALLOWED_INTERNAL_CIDRS": "[]",
    // Zero Trust のチーム名（<team>.cloudflareaccess.com）と Access アプリの AUD タグ
    "ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "ACCESS_AUD": ""
  }
  // SIGNING_PRIVATE_KEY は `html-share keys store`（wrangler secret put）で登録する
}
